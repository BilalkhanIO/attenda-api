  @@index([user_id])
  @@map("project_members")
}

model ProjectTask {
  id                  String    @id @default(uuid())
  project_id          String
  assignee_id         String?
  created_by          String
  title               String    @db.VarChar(220)
  description         String?   @db.Text
  status              String    @default("todo") @db.VarChar(30)
  priority            String    @default("medium") @db.VarChar(20)
  due_date            DateTime? @db.Date
  start_date          DateTime? @db.Date
  parent_task_id      String?
  is_milestone        Boolean   @default(false)
  completed_at        DateTime?
  performance_goal_id String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  project          Project                 @relation(fields: [project_id], references: [id], onDelete: Cascade)
  assignee         User?                   @relation("ProjectTaskAssignee", fields: [assignee_id], references: [id], onDelete: SetNull)
  creator          User                    @relation("ProjectTaskCreator", fields: [created_by], references: [id])
  performance_goal PerformanceGoal?        @relation(fields: [performance_goal_id], references: [id], onDelete: SetNull)
  attachments      ProjectAttachment[]
  parent           ProjectTask?            @relation("ProjectTaskSubtasks", fields: [parent_task_id], references: [id], onDelete: Cascade)
  subtasks         ProjectTask[]           @relation("ProjectTaskSubtasks")
  comments         ProjectTaskComment[]
  dependencies     ProjectTaskDependency[] @relation("TaskBlockedBy")
  blocking         ProjectTaskDependency[] @relation("TaskBlocks")
  time_entries     TimeEntry[]

  @@index([project_id, status])
  @@index([assignee_id, status])
  @@map("project_tasks")
}

model TimeEntry {
  id            String    @id @default(uuid())
