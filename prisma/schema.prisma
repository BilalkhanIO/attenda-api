generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organisation {
  id                            String    @id @default(uuid())
  name                          String    @db.VarChar(255)
  logo_url                      String?
  timezone                      String    @db.VarChar(100)
  currency                      String    @default("USD") @db.VarChar(10)
  country_code                  String?   @db.Char(2)
  office_ips                    String[]  @default([])
  office_ssids                  String[]  @default([])
  wifi_auto_checkin_enabled     Boolean   @default(true)
  wifi_auto_checkout_enabled    Boolean   @default(false)
  wa_enabled                    Boolean   @default(false)
  wa_phone_number_id            String?
  wa_access_token               String?
  wa_groups                     Json      @default("[]")
  wa_events                     Json      @default("{}")
  wa_dept_groups                Json      @default("{}")
  wa_monthly_message_limit      Int?
  wa_alert_threshold_percent    Int       @default(80)
  wa_estimated_cost_per_message Decimal?  @db.Decimal(10, 4)
  ai_enabled                    Boolean   @default(true)
  ai_monthly_request_limit      Int?
  payroll_day                   Int       @default(28)
  monthly_pay_divisor           Int       @default(26)
  tax_rate                      Float     @default(0)
  pension_rate                  Float     @default(0)
  late_threshold                Int       @default(15)
  heartbeat_grace_mins          Int       @default(20)
  gap_forgiveness_mins          Int       @default(15)
  compliance_pack_key           String    @default("unconfigured") @db.VarChar(80)
  attendance_security           Json?
  leave_accrual                 Json?
  late_policy                   Json?
  plan                          String    @default("trial") @db.VarChar(50)
  status                        String    @default("active") @db.VarChar(20)
  subscription_status           String    @default("active") @db.VarChar(30)
  trial_started_at              DateTime?
  trial_ends_at                 DateTime?
  seats_limit                   Int?
  features_override             Json?
  admin_notes                   String?   @db.Text
  billing_email                 String?   @db.VarChar(255)
  contact_name                  String?   @db.VarChar(255)
  contact_email                 String?   @db.VarChar(255)
  company_size                  String?   @db.VarChar(50)
  totp_required                 Boolean   @default(false)
  address                       String?   @db.Text
  phone                         String?   @db.VarChar(50)
  website                       String?   @db.VarChar(255)
  industry                      String?   @db.VarChar(100)
  registration_number           String?   @db.VarChar(100)
  created_at                    DateTime  @default(now())

  users                        User[]
  locations                    Location[]
  attendance_records           AttendanceRecord[]
  attendance_corrections       AttendanceCorrection[]
  leave_requests               LeaveRequest[]
  leave_balances               LeaveBalance[]
  leave_ledger_entries         LeaveLedgerEntry[]          @relation("LeaveLedgerOrg")
  shifts                       Shift[]
  emergency_shift_offers       EmergencyShiftOffer[]
  shift_checkpoints            ShiftCheckpoint[]
  checkpoint_scans             ShiftCheckpointScan[]
  shift_availability           ShiftAvailability[]
  shift_coverage_rules         ShiftCoverageRule[]
  shift_schedule_events        ShiftScheduleEvent[]
  payroll_records              PayrollRecord[]
  pay_rates                    PayRate[]
  statutory_parameter_sets     StatutoryParameterSet[]
  whatsapp_logs                WhatsappLog[]
  whatsapp_usage_periods       WhatsAppUsagePeriod[]
  ai_usage_periods             AiUsagePeriod[]
  ai_tool_audits               AiToolAudit[]
  performance_reviews          PerformanceReview[]
  overtime_rules               OvertimeRule[]
  overtime_requests            OvertimeRequest[]
  notifications                InAppNotification[]
  late_arrival_notices         LateArrivalNotice[]
  org_roles                    OrgRole[]
  user_permission_grants       UserPermissionGrant[]
  departments                  Department[]
  holidays                     OrgHoliday[]
  expense_claims               ExpenseClaim[]
  outbound_webhooks            OrgWebhook[]
  webhook_deliveries           OrgWebhookDelivery[]
  employee_documents           EmployeeDocument[]
  announcements                Announcement[]
  onboarding_templates         OnboardingTemplate[]
  onboarding_tasks             OnboardingTask[]
  kudos                        Kudos[]
  projects                     Project[]
  time_entries                 TimeEntry[]
  timesheets                   Timesheet[]
  leave_accrual_runs           LeaveAccrualRun[]
  leave_accrual_grants         LeaveAccrualGrant[]
  outbox_events                OutboxEvent[]
  labor_budgets                LaborBudget[]
  compliance_rules             ComplianceRule[]
  compliance_violations        ComplianceViolation[]
  report_schedules             ReportSchedule[]
  report_runs                  ReportRun[]
  report_definitions           ReportDefinition[]
  notification_deliveries      NotificationDelivery[]
  offboarding_cases            OffboardingCase[]
  offboarding_settlements      OffboardingSettlement[]
  scheduler_job_markers        SchedulerJobMarker[]
  scheduled_jobs               OrganizationJobSchedule[]
  api_keys                     PublicApiKey[]
  calendar_feeds               CalendarFeed[]
  attendance_sync_watermarks   AttendanceSyncWatermark[]
  attendance_devices           AttendanceDevice[]
  attendance_device_challenges AttendanceDeviceChallenge[]

  @@map("organisations")
}

model ReportSchedule {
  id          String    @id @default(uuid())
  org_id      String
  owner_id    String
  name        String    @db.VarChar(160)
  report_type String    @db.VarChar(32)
  params      Json
  frequency   String    @db.VarChar(16)
  local_time  String    @db.VarChar(5)
  timezone    String    @db.VarChar(100)
  recipients  String[]  @default([])
  status      String    @default("active") @db.VarChar(16)
  next_run_at DateTime
  last_run_at DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  organisation Organisation @relation(fields: [org_id], references: [id], onDelete: Cascade)
  owner        User         @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  runs         ReportRun[]

  @@index([status, next_run_at])
  @@index([org_id, owner_id, created_at])
  @@map("report_schedules")
}

model ReportDefinition {
  id         String   @id @default(uuid())
  org_id     String
  owner_id   String
  name       String   @db.VarChar(120)
  definition Json
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  organisation Organisation @relation(fields: [org_id], references: [id], onDelete: Cascade)
  owner        User         @relation(fields: [owner_id], references: [id], onDelete: Cascade)

  @@unique([org_id, owner_id, name])
  @@index([org_id, owner_id, updated_at(sort: Desc)])
  @@map("report_definitions")
}

model ReportRun {
  id            String    @id @default(uuid())
  org_id        String
  owner_id      String
  schedule_id   String?
  report_type   String    @db.VarChar(32)
  params        Json
  status        String    @default("queued") @db.VarChar(16)
  scheduled_for DateTime?
  download_url  String?   @db.Text
  row_count     Int?
  error         String?   @db.Text
  started_at    DateTime?
  completed_at  DateTime?
  created_at    DateTime  @default(now())

  organisation Organisation    @relation(fields: [org_id], references: [id], onDelete: Cascade)
  owner        User            @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  schedule     ReportSchedule? @relation(fields: [schedule_id], references: [id], onDelete: SetNull)

  @@unique([schedule_id, scheduled_for])
  @@index([org_id, owner_id, created_at])
  @@map("report_runs")
}

model NotificationDelivery {
  id           String    @id @default(uuid())
  org_id       String
  user_id      String
  event_id     String    @db.VarChar(36)
  event_type   String    @db.VarChar(60)
  channel      String    @db.VarChar(16)
  title        String    @db.VarChar(255)
  body         String    @db.Text
  action_type  String?   @db.VarChar(60)
  action_id    String?
  status       String    @default("queued") @db.VarChar(16)
  attempts     Int       @default(0)
  available_at DateTime  @default(now())
  last_error   String?   @db.Text
  provider_ref String?   @db.VarChar(255)
  sent_at      DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  organisation Organisation @relation(fields: [org_id], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([event_id, channel])
  @@index([status, available_at])
  @@index([org_id, user_id, created_at])
  @@map("notification_deliveries")
}

model SchedulerJobState {
  job_key         String    @id @db.VarChar(100)
  last_started_at DateTime?
  last_success_at DateTime?
  last_error      String?   @db.Text
  updated_at      DateTime  @updatedAt

  @@map("scheduler_job_states")
}

model SchedulerJobMarker {
  id         String    @id @default(uuid())
  org_id     String
  job_key    String    @db.VarChar(100)
  subject_id String    @db.VarChar(100)
  period_key String    @db.VarChar(80)
  status     String    @default("processing") @db.VarChar(16)
  attempts   Int       @default(1)
  locked_at  DateTime  @default(now())
  sent_at    DateTime?
  last_error String?   @db.Text
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  organisation Organisation @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@unique([org_id, job_key, subject_id, period_key])
  @@index([status, locked_at])
  @@index([created_at])
  @@map("scheduler_job_markers")
}

model OrganizationJobSchedule {
  org_id          String
  job_key         String    @db.VarChar(100)
  timezone        String    @db.VarChar(100)
  schedule_config String    @db.VarChar(160)
  next_run_at     DateTime
  last_run_at     DateTime?
  updated_at      DateTime  @updatedAt

  organisation Organisation @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@id([org_id, job_key])
  @@index([job_key, next_run_at, org_id])
  @@map("organization_job_schedules")
}

model OffboardingCase {
  id                  String    @id @default(uuid())
  org_id              String
  user_id             String
  opened_by           String
  case_type           String    @db.VarChar(24)
  notice_at           DateTime  @default(now())
  last_working_day    DateTime  @db.Date
  status              String    @default("planning") @db.VarChar(24)
  confidential_reason String?   @db.Text
  cancellation_reason String?   @db.Text
  access_revoked_at   DateTime?
  sessions_revoked_at DateTime?
  completed_at        DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  organisation Organisation           @relation(fields: [org_id], references: [id], onDelete: Cascade)
  subject      User                   @relation("OffboardingSubject", fields: [user_id], references: [id])
  opener       User                   @relation("OffboardingOpener", fields: [opened_by], references: [id])
  tasks        OffboardingTask[]
  assets       OffboardingAsset[]
  settlement   OffboardingSettlement?

  @@index([org_id, status, last_working_day])
  @@index([org_id, user_id, created_at])
  @@map("offboarding_cases")
}

model OffboardingTask {
  id           String    @id @default(uuid())
  case_id      String
  title        String    @db.VarChar(200)
  description  String?   @db.Text
  owner_id     String?
  due_date     DateTime? @db.Date
  status       String    @default("pending") @db.VarChar(20)
  completed_at DateTime?
  completed_by String?
  created_at   DateTime  @default(now())

  offboarding OffboardingCase @relation(fields: [case_id], references: [id], onDelete: Cascade)
  owner       User?           @relation("OffboardingTaskOwner", fields: [owner_id], references: [id], onDelete: SetNull)
  completer   User?           @relation("OffboardingTaskCompleter", fields: [completed_by], references: [id], onDelete: SetNull)

  @@index([case_id, status])
  @@map("offboarding_tasks")
}

model OffboardingAsset {
  id            String    @id @default(uuid())
  case_id       String
  asset_name    String    @db.VarChar(200)
  serial_number String?   @db.VarChar(120)
  status        String    @default("outstanding") @db.VarChar(20)
  due_date      DateTime? @db.Date
  resolved_at   DateTime?
  note          String?   @db.Text
  created_at    DateTime  @default(now())

  offboarding OffboardingCase @relation(fields: [case_id], references: [id], onDelete: Cascade)

  @@index([case_id, status])
  @@map("offboarding_assets")
}

model OffboardingSettlement {
  id            String    @id @default(uuid())
  org_id        String
  case_id       String    @unique
  currency      String    @default("PKR") @db.VarChar(3)
  items         Json
  total_amount  Int
  status        String    @default("draft") @db.VarChar(16)
  created_by    String
  submitted_at  DateTime?
  reviewed_by   String?
  reviewed_at   DateTime?
  reviewer_note String?   @db.Text
  locked_by     String?
  locked_at     DateTime?
  waiver_reason String?   @db.Text
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  organisation Organisation    @relation(fields: [org_id], references: [id], onDelete: Cascade)
  offboarding  OffboardingCase @relation(fields: [case_id], references: [id], onDelete: Cascade)
  creator      User            @relation("OffboardingSettlementCreator", fields: [created_by], references: [id])
  reviewer     User?           @relation("OffboardingSettlementReviewer", fields: [reviewed_by], references: [id])
  locker       User?           @relation("OffboardingSettlementLocker", fields: [locked_by], references: [id])

  @@index([org_id, status, created_at])
  @@map("offboarding_settlements")
}

model IdempotencyRecord {
  id            String   @id @default(uuid())
  org_id        String
  user_id       String
  key           String   @db.VarChar(128)
  request_hash  String   @db.VarChar(64)
  state         String   @default("processing") @db.VarChar(20)
  status_code   Int?
  response_body Json?
  expires_at    DateTime
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@unique([org_id, user_id, key])
  @@index([expires_at])
  @@map("idempotency_records")
}

model User {
  id                      String                 @id @default(uuid())
  org_id                  String
  name                    String                 @db.VarChar(255)
  email                   String                 @unique @db.VarChar(255)
  password_hash           String
  role                    String                 @db.VarChar(50)
  department              String?                @db.VarChar(100)
  department_id           String?
  job_title               String?                @db.VarChar(100)
  phone                   String?                @db.VarChar(30)
  manager_id              String?
  hourly_rate             Decimal                @default(0) @db.Decimal(10, 2)
  avatar_url              String?
  is_active               Boolean                @default(true)
  setup_complete          Boolean                @default(false)
  invite_token            String?                @unique
  invite_expires          DateTime?
  reset_token             String?                @unique
  reset_expires           DateTime?
  login_attempts          Int                    @default(0)
  locked_until            DateTime?
  totp_secret             String?
  totp_enabled            Boolean                @default(false)
  notification_prefs      Json                   @default("{\"categories\":{\"attendance\":true,\"requests\":true,\"shifts\":true,\"projects\":true,\"payroll\":true,\"announcements\":true,\"documents\":true,\"security\":true},\"channels\":{\"in_app\":true,\"push\":true,\"email\":false,\"whatsapp\":false},\"quiet_hours\":{\"enabled\":false,\"start\":\"22:00\",\"end\":\"08:00\"},\"digest\":\"off\"}")
  report_schedules        ReportSchedule[]
  report_runs             ReportRun[]
  report_definitions      ReportDefinition[]
  notification_deliveries NotificationDelivery[]
  google_id               String?                @unique
  date_of_birth           DateTime?              @db.Date
  gender                  String?                @db.VarChar(20)
  address                 String?                @db.Text
  city                    String?                @db.VarChar(100)
  country                 String?                @db.VarChar(100)
  primary_location_id     String?
  emergency_contact_name  String?                @db.VarChar(255)
  emergency_contact_phone String?                @db.VarChar(50)
  employment_type         String?                @db.VarChar(30)
  joined_at               DateTime?              @db.Date
  national_id             String?                @db.VarChar(100)
  fcm_token               String?
  fcm_token_updated_at    DateTime?
  whatsapp_opted_in_at    DateTime?
  created_at              DateTime               @default(now())
  deleted_at              DateTime?

  org                                Organisation                @relation(fields: [org_id], references: [id])
  primary_location                   Location?                   @relation("UserPrimaryLocation", fields: [primary_location_id], references: [id], onDelete: SetNull)
  locations_created                  Location[]                  @relation("LocationCreator")
  department_ref                     Department?                 @relation(fields: [department_id], references: [id], onDelete: SetNull)
  manager                            User?                       @relation("UserManager", fields: [manager_id], references: [id])
  direct_reports                     User[]                      @relation("UserManager")
  attendance_records                 AttendanceRecord[]
  corrections_requested              AttendanceCorrection[]      @relation("CorrectionUser")
  corrections_reviewed               AttendanceCorrection[]      @relation("CorrectionReviewer")
  expense_claims                     ExpenseClaim[]              @relation("ExpenseClaimant")
  expenses_reviewed                  ExpenseClaim[]              @relation("ExpenseReviewer")
  documents                          EmployeeDocument[]          @relation("DocumentOwner")
  documents_uploaded                 EmployeeDocument[]          @relation("DocumentUploader")
  announcements_authored             Announcement[]              @relation("AnnouncementAuthor")
  announcement_receipts              AnnouncementReceipt[]
  onboarding_templates_created       OnboardingTemplate[]        @relation("OnboardingTemplateCreator")
  onboarding_tasks                   OnboardingTask[]            @relation("OnboardingHire")
  onboarding_tasks_assigned          OnboardingTask[]            @relation("OnboardingAssignee")
  kudos_given                        Kudos[]                     @relation("KudosGiver")
  kudos_received                     Kudos[]                     @relation("KudosRecipient")
  leave_requests                     LeaveRequest[]
  leave_balances                     LeaveBalance[]
  leave_ledger_entries               LeaveLedgerEntry[]          @relation("LeaveLedgerSubject")
  leave_ledger_actions               LeaveLedgerEntry[]          @relation("LeaveLedgerActor")
  leave_accrual_grants               LeaveAccrualGrant[]
  reviewed_leaves                    LeaveRequest[]              @relation("LeaveReviewer")
  shift_assignments                  ShiftAssignment[]
  checkpoint_scans                   ShiftCheckpointScan[]
  emergency_offers_created           EmergencyShiftOffer[]       @relation("EmergencyShiftCreator")
  emergency_offers_claimed           EmergencyShiftOffer[]       @relation("EmergencyShiftClaimer")
  shift_availability                 ShiftAvailability[]
  shift_events                       ShiftScheduleEvent[]        @relation("ShiftEventActor")
  swap_requests_sent                 ShiftSwap[]                 @relation("SwapRequester")
  swap_requests_received             ShiftSwap[]                 @relation("SwapTarget")
  payroll_records                    PayrollRecord[]
  processed_payrolls                 PayrollRecord[]             @relation("PayrollProcessor")
  generated_payrolls                 PayrollRecord[]             @relation("PayrollGenerator")
  statutory_parameter_sets_created   StatutoryParameterSet[]     @relation("StatutorySetCreator")
  statutory_parameter_sets_activated StatutoryParameterSet[]     @relation("StatutorySetActivator")
  pay_rates                          PayRate[]                   @relation("PayRateEmployee")
  pay_rates_created                  PayRate[]                   @relation("PayRateCreator")
  locations_managed                  LocationManager[]           @relation("LocationManagerUser")
  performance_reviews                PerformanceReview[]         @relation("ReviewSubject")
  submitted_reviews                  PerformanceReview[]         @relation("ReviewSubmitter")
  performance_goals                  PerformanceGoal[]
  remote_sessions                    RemoteSession[]
  notifications                      InAppNotification[]
  late_arrival_notices               LateArrivalNotice[]
  overtime_requests                  OvertimeRequest[]
  org_role_assignment                UserOrgRole?
  permission_grants                  UserPermissionGrant[]
  refresh_tokens                     RefreshToken[]
  sessions                           UserSession[]
  api_keys                           PublicApiKey[]
  calendar_feed                      CalendarFeed?
  attendance_sync_watermarks         AttendanceSyncWatermark[]
  attendance_devices_owned           AttendanceDevice[]          @relation("AttendanceDeviceOwner")
  attendance_devices_approved        AttendanceDevice[]          @relation("AttendanceDeviceApprover")
  attendance_device_challenges       AttendanceDeviceChallenge[] @relation("AttendanceDeviceChallengeOwner")
  platform_role_assignments          PlatformUserRole[]
  projects_owned                     Project[]                   @relation("ProjectOwner")
  time_entries                       TimeEntry[]
  timesheets                         Timesheet[]                 @relation("TimesheetOwner")
  timesheets_reviewed                Timesheet[]                 @relation("TimesheetReviewer")
  project_memberships                ProjectMember[]
  project_tasks_assigned             ProjectTask[]               @relation("ProjectTaskAssignee")
  project_tasks_created              ProjectTask[]               @relation("ProjectTaskCreator")
  project_attachments                ProjectAttachment[]
  project_task_comments              ProjectTaskComment[]
  ai_conversations                   AiConversation[]
  offboarding_subjects               OffboardingCase[]           @relation("OffboardingSubject")
  offboarding_opened                 OffboardingCase[]           @relation("OffboardingOpener")
  offboarding_tasks_owned            OffboardingTask[]           @relation("OffboardingTaskOwner")
  offboarding_tasks_done             OffboardingTask[]           @relation("OffboardingTaskCompleter")
  offboarding_settlements_created    OffboardingSettlement[]     @relation("OffboardingSettlementCreator")
  offboarding_settlements_reviewed   OffboardingSettlement[]     @relation("OffboardingSettlementReviewer")
  offboarding_settlements_locked     OffboardingSettlement[]     @relation("OffboardingSettlementLocker")

  @@index([org_id])
  @@index([org_id, created_at(sort: Desc), id])
  @@index([org_id, primary_location_id, is_active, deleted_at])
  @@index([primary_location_id])
  @@map("users")
}

model Location {
  id           String   @id @default(uuid())
  org_id       String
  name         String   @db.VarChar(120)
  address      String?  @db.Text
  timezone     String   @db.VarChar(100)
  office_ips   String[] @default([])
  office_ssids String[] @default([])
  geofence     Json?
  is_main      Boolean  @default(false)
  is_active    Boolean  @default(true)
  created_by   String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  org                Organisation       @relation(fields: [org_id], references: [id], onDelete: Cascade)
  creator            User?              @relation("LocationCreator", fields: [created_by], references: [id], onDelete: SetNull)
  primary_users      User[]             @relation("UserPrimaryLocation")
  managers           LocationManager[]
  attendance_records AttendanceRecord[]
  shift_assignments  ShiftAssignment[]
  leave_requests     LeaveRequest[]
  labor_budgets      LaborBudget[]
  holidays           OrgHoliday[]

  @@unique([org_id, name])
  @@index([org_id, is_active, name])
  @@map("locations")
}

model LocationManager {
  location_id String
  user_id     String
  created_at  DateTime @default(now())

  location Location @relation(fields: [location_id], references: [id], onDelete: Cascade)
  user     User     @relation("LocationManagerUser", fields: [user_id], references: [id], onDelete: Cascade)

  @@id([location_id, user_id])
  @@index([user_id, location_id])
  @@map("location_managers")
}

model AttendanceCorrection {
  id                  String    @id @default(uuid())
  user_id             String
  org_id              String
  attendance_id       String?
  date                DateTime  @db.Date
  requested_check_in  DateTime?
  requested_check_out DateTime?
  reason              String
  status              String    @default("pending")
  reviewed_by         String?
  review_note         String?
  reviewed_at         DateTime?
  created_at          DateTime  @default(now())

  user       User              @relation("CorrectionUser", fields: [user_id], references: [id])
  reviewer   User?             @relation("CorrectionReviewer", fields: [reviewed_by], references: [id])
  org        Organisation      @relation(fields: [org_id], references: [id])
  attendance AttendanceRecord? @relation(fields: [attendance_id], references: [id])

  @@index([org_id, status])
  @@map("attendance_corrections")
}

model OrgHoliday {
  id          String   @id @default(uuid())
  org_id      String
  location_id String?
  date        DateTime @db.Date
  name        String   @db.VarChar(120)
  recurring   Boolean  @default(false)
  created_at  DateTime @default(now())

  org      Organisation @relation(fields: [org_id], references: [id])
  location Location?    @relation(fields: [location_id], references: [id], onDelete: SetNull)

  @@index([org_id, location_id, date])
  @@map("org_holidays")
}

// Outbound webhook endpoints: per-org HTTPS receivers of coarse org events
// (same event types the SSE bus emits). Deliveries are HMAC-SHA256 signed
// with the per-hook secret; 20 consecutive failures auto-disable the hook.
model OrgWebhook {
  id                         String    @id @default(uuid())
  org_id                     String
  url                        String
  secret                     String
  previous_secret            String?
  previous_secret_expires_at DateTime?
  events                     String[]  @default([])
  is_active                  Boolean   @default(true)
  last_success_at            DateTime?
  last_failure_at            DateTime?
  failure_count              Int       @default(0)
  created_at                 DateTime  @default(now())

  org        Organisation         @relation(fields: [org_id], references: [id], onDelete: Cascade)
  deliveries OrgWebhookDelivery[]

  @@index([org_id])
  @@map("org_webhooks")
