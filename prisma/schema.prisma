  org_id          String
  date            DateTime  @db.Date
  expected_time   String    @db.VarChar(10) // HH:MM wall-clock — expected arrival
  reason          String    @db.Text
  status          String    @default("pending") @db.VarChar(20) // pending | acknowledged | cancelled
  acknowledged_by String?
  acknowledged_at DateTime?
  created_at      DateTime  @default(now())

  user               User               @relation(fields: [user_id], references: [id])
  org                Organisation       @relation(fields: [org_id], references: [id])
  attendance_records AttendanceRecord[]

  @@unique([user_id, date])
  @@map("late_arrival_notices")
}

// Announcements 2.0: persisted announcements (previously a pure notification
// fan-out) with optional publish scheduling and department targeting.
// published_at null ⇒ waiting for the 5-min publisher job.
model Announcement {
  id            String    @id @default(uuid())
  org_id        String
  title         String    @db.VarChar(255)
  body          String    @db.Text
  department_id String? // null ⇒ org-wide
  scheduled_for DateTime? // null ⇒ published immediately on create
  published_at  DateTime?
  created_by    String
  created_at    DateTime  @default(now())

  org        Organisation          @relation(fields: [org_id], references: [id], onDelete: Cascade)
  author     User                  @relation("AnnouncementAuthor", fields: [created_by], references: [id])
  department Department?           @relation(fields: [department_id], references: [id], onDelete: SetNull)
  receipts   AnnouncementReceipt[]

  @@index([org_id, published_at])
  @@map("announcements")
}

// Onboarding checklists: a template holds ordered items; assigning it to a
// hire materializes each item as an OnboardingTask (denormalized title/desc
// so later template edits never rewrite in-flight checklists). Items owned
// by 'manager' resolve to the hire's manager at assignment time, falling
// back to the hire when they have no manager.
model OnboardingTemplate {
  id         String    @id @default(uuid())
  org_id     String
  name       String    @db.VarChar(120)
  is_default Boolean   @default(false) // auto-assigned to every new user
  created_by String
  created_at DateTime  @default(now())
  deleted_at DateTime?

  org     Organisation             @relation(fields: [org_id], references: [id], onDelete: Cascade)
  creator User                     @relation("OnboardingTemplateCreator", fields: [created_by], references: [id])
  items   OnboardingTemplateItem[]
  tasks   OnboardingTask[]

  @@index([org_id])
  @@map("onboarding_templates")
}

model OnboardingTemplateItem {
  id            String  @id @default(uuid())
  template_id   String
  title         String  @db.VarChar(200)
  description   String?
  due_days      Int? // days after assignment the item is due
  sort_order    Int     @default(0)
  assignee_role String  @default("employee") @db.VarChar(20) // employee | manager

  template OnboardingTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@map("onboarding_template_items")
}

model OnboardingTask {
  id               String    @id @default(uuid())
  org_id           String
  user_id          String // the new hire
  item_title       String    @db.VarChar(200)
  item_description String?
  assignee_id      String // resolved at assignment: the hire or their manager
  due_date         DateTime? @db.Date
  status           String    @default("pending") @db.VarChar(20) // pending | done | skipped
  completed_at     DateTime?
  completed_by     String?
  template_id      String?
  created_at       DateTime  @default(now())

  org      Organisation        @relation(fields: [org_id], references: [id], onDelete: Cascade)
  user     User                @relation("OnboardingHire", fields: [user_id], references: [id], onDelete: Cascade)
  assignee User                @relation("OnboardingAssignee", fields: [assignee_id], references: [id])
  template OnboardingTemplate? @relation(fields: [template_id], references: [id], onDelete: SetNull)

  @@index([org_id, user_id])
  @@index([assignee_id, status])
  @@map("onboarding_tasks")
}

// Kudos / recognition feed: any org member can publicly thank another.
// Soft-deleted (author or org.settings.update) so moderation keeps the
// audit trail intact. Capped at 20 per giver per day in the router.
model Kudos {
  id           String    @id @default(uuid())
  org_id       String
  from_user_id String
  to_user_id   String
  message      String
  emoji        String?   @db.VarChar(20)
  created_at   DateTime  @default(now())
  deleted_at   DateTime?

  org       Organisation @relation(fields: [org_id], references: [id], onDelete: Cascade)
  giver     User         @relation("KudosGiver", fields: [from_user_id], references: [id])
  recipient User         @relation("KudosRecipient", fields: [to_user_id], references: [id])

  @@index([org_id, created_at])
  @@map("kudos")
}

// Read receipts: one row per (announcement, reader), upserted idempotently.
model AnnouncementReceipt {
  id              String   @id @default(uuid())
  announcement_id String
  user_id         String
  read_at         DateTime @default(now())

  announcement Announcement @relation(fields: [announcement_id], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([announcement_id, user_id])
  @@map("announcement_receipts")
}

model PlanDefinition {
  id            String   @id @db.VarChar(50)
  display_name  String   @db.VarChar(100)
  price_monthly Decimal  @default(0) @db.Decimal(10, 2)
  price_annual  Decimal  @default(0) @db.Decimal(10, 2)
  max_employees Int      @default(0)
  trial_days    Int      @default(14)
  features      Json     @default("{}")
  description   String?  @db.Text
  highlight     Boolean  @default(false)
  is_active     Boolean  @default(true)
  sort_order    Int      @default(0)
  updated_at    DateTime @default(now()) @updatedAt

  @@map("plan_definitions")
}

// ─── Dynamic RBAC ─────────────────────────────────────
model Permission {
  key         String  @id @db.VarChar(100)
  module      String  @db.VarChar(50)
  description String? @db.Text

  org_role_permissions      OrgRolePermission[]
  user_permission_grants    UserPermissionGrant[]
  platform_role_permissions PlatformRolePermission[]

  @@map("permissions")
}

model OrgRole {
  id         String   @id @default(uuid())
  org_id     String
  name       String   @db.VarChar(100)
  slug       String   @db.VarChar(50)
  is_system  Boolean  @default(false)
  created_at DateTime @default(now())

  org         Organisation        @relation(fields: [org_id], references: [id], onDelete: Cascade)
  permissions OrgRolePermission[]
  users       UserOrgRole[]

  @@unique([org_id, slug])
  @@map("org_roles")
}

model OrgRolePermission {
  org_role_id    String
  permission_key String

  org_role   OrgRole    @relation(fields: [org_role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_key], references: [key], onDelete: Cascade)

  @@id([org_role_id, permission_key])
  @@map("org_role_permissions")
}

model UserOrgRole {
  id          String   @id @default(uuid())
  user_id     String   @unique
  org_role_id String
  created_at  DateTime @default(now())

  user     User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  org_role OrgRole @relation(fields: [org_role_id], references: [id], onDelete: Cascade)

  @@map("user_org_roles")
}

model UserPermissionGrant {
  id             String   @id @default(uuid())
  user_id        String
  org_id         String
  permission_key String
  effect         String   @db.VarChar(10) // allow | deny
  created_at     DateTime @default(now())

  user       User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  org        Organisation @relation(fields: [org_id], references: [id], onDelete: Cascade)
  permission Permission   @relation(fields: [permission_key], references: [key], onDelete: Cascade)

  @@unique([user_id, permission_key])
  @@map("user_permission_grants")
}

model PlatformRole {
  slug        String  @id @db.VarChar(50)
  name        String  @db.VarChar(100)
  description String? @db.Text

  permissions PlatformRolePermission[]
  users       PlatformUserRole[]

  @@map("platform_roles")
}

model PlatformRolePermission {
  platform_role_slug String @db.VarChar(50)
  permission_key     String @db.VarChar(100)

  platform_role PlatformRole @relation(fields: [platform_role_slug], references: [slug], onDelete: Cascade)
  permission    Permission   @relation(fields: [permission_key], references: [key], onDelete: Cascade)

  @@id([platform_role_slug, permission_key])
  @@map("platform_role_permissions")
}

model PlatformUserRole {
  user_id            String
  platform_role_slug String
  created_at         DateTime @default(now())

  user          User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  platform_role PlatformRole @relation(fields: [platform_role_slug], references: [slug], onDelete: Cascade)

  @@id([user_id, platform_role_slug])
  @@map("platform_user_roles")
}

model BlogPost {
  id               String    @id @default(uuid())
  slug             String    @unique @db.VarChar(255)
  title            String    @db.VarChar(500)
  excerpt          String?   @db.Text
  content          String    @default("") @db.Text
  author_name      String    @default("Attenda Team") @db.VarChar(255)
  author_avatar    String?   @db.VarChar(500)
  cover_image      String?   @db.VarChar(500)
  tags             String[]  @default([])
  meta_title       String?   @db.VarChar(500)
  meta_description String?   @db.Text
  og_image         String?   @db.VarChar(500)
  is_published     Boolean   @default(false)
  published_at     DateTime?
  read_time_mins   Int?
  views            Int       @default(0)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @default(now()) @updatedAt

  @@map("blog_posts")
}

model AiConversation {
  id        String      @id @default(uuid())
  orgId     String      @map("org_id")
  userId    String?     @map("user_id")
  context   String?     @db.Text
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  messages  AiMessage[]
  user      User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(uuid())
  sequence       BigInt   @unique @default(autoincrement())
  conversationId String   @map("conversation_id")
  role           String // "user" | "assistant" | "system"
  content        String
  toolCalls      Json?    @map("tool_calls")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

model AiUsagePeriod {
  id                String       @id @default(uuid())
  org_id            String
  period_start      DateTime     @db.Date
  request_count     Int          @default(0)
  prompt_tokens     BigInt       @default(0)
  completion_tokens BigInt       @default(0)
  total_tokens      BigInt       @default(0)
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt
  org               Organisation @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@unique([org_id, period_start])
  @@index([org_id, period_start(sort: Desc)])
  @@map("ai_usage_periods")
}

model AiToolAudit {
  id              String       @id @default(uuid())
  org_id          String
  actor_user_id   String
  on_behalf_of    String
  conversation_id String
  tool_name       String       @db.VarChar(120)
  arguments_hash  String       @db.Char(64)
  success         Boolean
  created_at      DateTime     @default(now())
  org             Organisation @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@index([org_id, created_at(sort: Desc)])
  @@index([org_id, actor_user_id, created_at(sort: Desc)])
  @@map("ai_tool_audits")
}
