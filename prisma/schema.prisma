}

// Employee expense claims: submit → approve/reject → reimburse through the
// existing payroll manual-adjustment machinery (recall/adjust flow).
model ExpenseClaim {
  id                       String    @id @default(uuid())
  user_id                  String
  org_id                   String
  amount                   Decimal   @db.Decimal(12, 2)
  currency                 String    @db.VarChar(10)
  category                 String    @db.VarChar(50)
  description              String
  expense_date             DateTime  @db.Date
  receipt_url              String?
  status                   String    @default("pending") // pending | approved | rejected | reimbursed
  reviewed_by              String?
  review_note              String?
  reviewed_at              DateTime?
  reimbursed_in_payroll_id String?
  created_at               DateTime  @default(now())

  user          User           @relation("ExpenseClaimant", fields: [user_id], references: [id])
  reviewer      User?          @relation("ExpenseReviewer", fields: [reviewed_by], references: [id])
  org           Organisation   @relation(fields: [org_id], references: [id])
  reimbursed_in PayrollRecord? @relation(fields: [reimbursed_in_payroll_id], references: [id])

  @@index([org_id, status])
  @@index([org_id, created_at(sort: Desc), id])
  @@map("expense_claims")
}

// Employee document vault: HR/self-uploaded files (contracts, IDs, visas,
// certificates) stored in S3 under documents/<org>/<user>/. Rows are
// soft-deleted (deleted_at) so the audit trail keeps pointing at real data.
model EmployeeDocument {
  id          String    @id @default(uuid())
  user_id     String
  org_id      String
  title       String    @db.VarChar(200)
  category    String    @db.VarChar(50) // contract | id | visa | certificate | other
  file_key    String
  file_name   String
  file_size   Int
  mime_type   String    @db.VarChar(100)
  expires_at  DateTime? @db.Date
  uploaded_by String
  created_at  DateTime  @default(now())
  deleted_at  DateTime?

  owner    User         @relation("DocumentOwner", fields: [user_id], references: [id])
  uploader User         @relation("DocumentUploader", fields: [uploaded_by], references: [id])
  org      Organisation @relation(fields: [org_id], references: [id])

  @@index([org_id, user_id])
  @@map("employee_documents")
}

model OvertimeRule {
  id              String   @id @default(uuid())
  org_id          String
  name            String   @db.VarChar(100)
