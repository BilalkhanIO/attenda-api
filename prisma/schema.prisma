model PayrollRecord {
  id                               String    @id @default(uuid())
  user_id                          String
  org_id                           String
  period_month                     Int
  period_year                      Int
  regular_hours                    Decimal   @db.Decimal(6, 2)
  overtime_hours                   Decimal   @default(0) @db.Decimal(6, 2)
  hourly_rate                      Decimal   @db.Decimal(10, 2)
  pay_basis                        String    @default("hourly") @db.VarChar(16)
  pay_rate_amount                  Decimal   @default(0) @db.Decimal(12, 2)
  pay_monthly_divisor              Int       @default(26)
  base_pay                         Decimal   @db.Decimal(12, 2)
  overtime_pay                     Decimal   @default(0) @db.Decimal(12, 2)
  unpaid_deduction                 Decimal   @default(0) @db.Decimal(12, 2)
  manual_adjustment                Decimal   @default(0) @db.Decimal(12, 2)
  adjustment_reason                String?
  gross_pay                        Decimal   @db.Decimal(12, 2)
  tax_deduction                    Decimal   @default(0) @db.Decimal(12, 2)
  pension_deduction                Decimal   @default(0) @db.Decimal(12, 2)
  net_pay                          Decimal   @default(0) @db.Decimal(12, 2)
  status                           String    @default("draft")
  is_incomplete                    Boolean   @default(false)
  inputs_hash                      String?   @db.VarChar(64)
  inputs_stale                     Boolean   @default(false)
  statutory_parameter_set_id       String?
  pay_rate_id                      String?
  tax_calculation_method           String?   @db.VarChar(30)
  employee_statutory_deductions    Json      @default("[]")
  employer_statutory_contributions Json      @default("[]")
  payslip_url                      String?
  generated_by                     String?
  processed_at                     DateTime?
  processed_by                     String?
  created_at                       DateTime  @default(now())

  user                    User                   @relation(fields: [user_id], references: [id])
  org                     Organisation           @relation(fields: [org_id], references: [id])
  processor               User?                  @relation("PayrollProcessor", fields: [processed_by], references: [id])
  generator               User?                  @relation("PayrollGenerator", fields: [generated_by], references: [id], onDelete: SetNull)
  reimbursed_expenses     ExpenseClaim[]
  statutory_parameter_set StatutoryParameterSet? @relation(fields: [statutory_parameter_set_id], references: [id], onDelete: SetNull)
  pay_rate                PayRate?               @relation(fields: [pay_rate_id], references: [id], onDelete: SetNull)

  @@unique([user_id, period_month, period_year])
  @@index([org_id, period_year, period_month])
  @@index([generated_by])
  @@map("payroll_records")
}

model PayRate {
  id              String          @id @default(uuid())
