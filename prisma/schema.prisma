  created_by      String?
  created_at      DateTime        @default(now())
  org             Organisation    @relation(fields: [org_id], references: [id], onDelete: Cascade)
  user            User            @relation("PayRateEmployee", fields: [user_id], references: [id], onDelete: Cascade)
