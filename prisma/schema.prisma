  claimer    User?            @relation("EmergencyShiftClaimer", fields: [claimed_by], references: [id], onDelete: SetNull)
  assignment ShiftAssignment? @relation("EmergencyShiftAssignment", fields: [assignment_id], references: [id], onDelete: SetNull)

  @@index([org_id, status, expires_at, date])
  @@index([shift_id, date])
