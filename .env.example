# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/attenda_db"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_REFRESH_SECRET="change-this-refresh-secret-too"
# Stable encryption key for sensitive idempotency replay bodies (such as one-time API credentials).
# Keep it stable for at least the 24-hour idempotency retention window. Required in production; development falls back to JWT_REFRESH_SECRET.
IDEMPOTENCY_RESPONSE_ENCRYPTION_KEY=""
JWT_EXPIRES_IN="8h"
JWT_REFRESH_EXPIRES_IN="30d"

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
API_PUBLIC_URL="http://localhost:5000" # Public origin used for personal ICS subscription URLs
API_INTERNAL_ORIGIN="http://127.0.0.1:5000" # Internal API origin used by sequential attendance batch sync

# WhatsApp (Meta Cloud API)
WHATSAPP_PHONE_ID=""
WHATSAPP_TOKEN=""
WHATSAPP_VERIFY_TOKEN="attenda_webhook_verify"
WHATSAPP_APP_SECRET=""

# Anthropic Claude API (Remote check-in parsing)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""              # Claude model for remote reply parsing (default: claude-sonnet-4-6)

# Gemini API (Attenda AI chat and project/task agent)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
AI_PRIMARY_PROVIDER="gemini"
# Optional OpenAI-compatible fallback; leave unset to use Gemini only.
AI_OPENAI_API_KEY=""
AI_OPENAI_BASE_URL="https://api.openai.com/v1"
AI_OPENAI_MODEL="gpt-4o-mini"

# AWS S3 (Payslips + logos)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET="attenda-files"

# Email (Password reset)
BREVO_API_KEY=""
BREVO_FROM_EMAIL=""
BREVO_FROM_NAME="Attenda"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@attenda.app"
